# =============================================================================
# Stage 1: Builder — install gems + precompile assets
# =============================================================================
FROM ruby:3.2.2-bookworm AS builder

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    build-essential \
    libpq-dev \
    nodejs \
    npm \
    git \
    curl \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install bundler
RUN gem install bundler:2.4.22

# Copy Gemfile first for layer caching
COPY Gemfile Gemfile.lock ./

# Install gems — production only, no dev/test gems
RUN bundle config set --local deployment true && \
    bundle config set --local without 'development test' && \
    bundle config set --local force_ruby_platform true && \
    bundle install --jobs 4

# Copy application code
COPY . .

# Precompile assets (Rails needs a secret key base for this step)
RUN SECRET_KEY_BASE=precompile_placeholder \
    RAILS_ENV=production \
    bundle exec rake assets:precompile

# =============================================================================
# Stage 2: Runtime — slim image with only what's needed
# =============================================================================
FROM ruby:3.2.2-slim-bookworm AS runtime

RUN apt-get update -qq && apt-get install -y --no-install-recommends \
    libpq5 \
    curl \
    ca-certificates \
  && rm -rf /var/lib/apt/lists/*

WORKDIR /app

# Install bundler (must match builder version)
RUN gem install bundler:2.4.22

# Copy gems from builder
COPY --from=builder /usr/local/bundle /usr/local/bundle

# Copy application code from builder
COPY --from=builder /app /app

# Create non-root user
RUN groupadd --gid 1000 appuser && \
    useradd --uid 1000 --gid appuser --shell /bin/bash --create-home appuser && \
    chown -R appuser:appuser /app

USER appuser

# Build arguments for versioning
ARG VERSION=dev
ARG GIT_SHA=unknown
ARG BUILD_TIME
ENV VERSION=${VERSION} \
    GIT_SHA=${GIT_SHA} \
    BUILD_TIME=${BUILD_TIME} \
    RAILS_ENV=production \
    RAILS_LOG_TO_STDOUT=true \
    RAILS_SERVE_STATIC_FILES=true \
    PORT=3000

EXPOSE 3000

# Health check
HEALTHCHECK --interval=30s --timeout=5s --start-period=15s --retries=3 \
  CMD curl -f http://localhost:3000/health || exit 1

# Start Puma
CMD ["bundle", "exec", "puma", "-C", "config/puma.rb"]
