{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "environmentName": {
      "value": "dev"
    },
    "location": {
      "value": "westeurope"
    },
    "publicApiUrl": {
      "value": "https://api-dev.cntrlplus.com"
    },
    "publicSiteUrl": {
      "value": "https://dev.cntrlplus.com"
    },
    "postgresSkuName": {
      "value": "Standard_B1ms"
    },
    "postgresSkuTier": {
      "value": "Burstable"
    },
    "postgresStorageGB": {
      "value": 32
    },
    "postgresBackupRetention": {
      "value": 7
    },
    "postgresHighAvailability": {
      "value": false
    },
    "redisSkuName": {
      "value": "Basic"
    },
    "redisSkuCapacity": {
      "value": 0
    },
    "registrySkuName": {
      "value": "Basic"
    },
    "mdiApiBase": {
      "value": "https://api.mdintegrations.com/v1"
    },
    "honeybeeApiBase": {
      "value": "https://partners.honeybeehealth.com"
    },
    "honeybeeAuthBase": {
      "value": "https://auth.sandbox.honeybeehealth.com"
    },
    "postgresAdminPassword": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "POSTGRES-ADMIN-PASSWORD"
      }
    },
    "railsMasterKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "RAILS-MASTER-KEY"
      }
    },
    "secretKeyBase": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "SECRET-KEY-BASE"
      }
    },
    "deviseSecretKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "DEVISE-SECRET-KEY"
      }
    },
    "mdiClientId": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "MDI-CLIENT-ID"
      }
    },
    "mdiClientSecret": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "MDI-CLIENT-SECRET"
      }
    },
    "honeybeeClientId": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "HONEYBEE-CLIENT-ID"
      }
    },
    "honeybeeSecretKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "HONEYBEE-SECRET-KEY"
      }
    },
    "honeybeeWebhookSecret": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "HONEYBEE-WEBHOOK-SECRET"
      }
    },
    "stripeSecretKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "STRIPE-SECRET-KEY"
      }
    },
    "stripePublishableKey": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<SUBSCRIPTION_ID>/resourceGroups/rg-cntrl-dev/providers/Microsoft.KeyVault/vaults/kv-cntrl-bootstrap"
        },
        "secretName": "STRIPE-PUBLISHABLE-KEY"
      }
    }
  }
}
