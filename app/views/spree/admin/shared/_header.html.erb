<% theme = AdminTheme.current %>
<header class="header logged-in">
  <nav class="navbar fixed-top navbar-dark flex-nowrap align-items-center" aria-label="Admin">
    <div class="col-3 col-sm-4 p-0 d-lg-none">
      <button
        id="sidebar-open"
        class="navbar-toggler h-100"
        type="button"
        aria-controls="main-sidebar"
        aria-expanded="false"
        aria-label="Open navigation">
        <%= svg_icon name: "menu.svg", width: '20', height: '20' %>
      </button>
    </div>

    <div class="col text-center text-lg-left px-0 text-truncate">
      <%= link_to spree.admin_path, class: 'admin-brand', title: theme.brand_name do %>
        <% if theme.logo.attached? %>
          <%= image_tag main_app.rails_storage_proxy_path(theme.logo, disposition: :inline), class: 'admin-logo', alt: theme.brand_name %>
        <% else %>
          <span class="admin-brand-text"><%= theme.brand_name %></span>
        <% end %>
      <% end %>
    </div>

    <div class="col-3 col-sm-4 text-right p-0">
      <%= render partial: 'spree/admin/shared/account_nav' %>
    </div>
  </nav>
</header>
