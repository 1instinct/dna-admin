<nav>
  <div class="text-right d-lg-none p-2 border-bottom">
    <button
      id="sidebar-close"
      class="btn btn-link"
      type="button"
      aria-expanded="false"
      aria-label="Toggle navigation">
      <%= svg_icon name: "cancel.svg", width: '20', height: '20' %>
    </button>
  </div>

  <% if can? :admin, Spree::Order %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarOrder">
      <%= tab *Spree::BackendConfiguration::ORDER_TABS, icon: 'list.svg' %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::IapTransaction %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarIapOrders">
      <%# Built by hand: the tab helper titleizes labels ("Iap Orders"). %>
      <li class="sidebar-menu-item d-block w-100 position-relative <%= 'selected' if %w[iap_transactions iap_products].include?(controller_name) %>">
        <%= link_to_with_icon 'list.svg', 'IAP Orders', spree.admin_iap_transactions_path, class: 'w-100 p-3 d-flex align-items-center' %>
      </li>
    </ul>
  <% end %>

  <% if can?(:admin, Spree::ReturnAuthorization) || can?(:admin, Spree::CustomerReturn) %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarReturn">
      <%= main_menu_tree Spree.t(:returns), icon: "returns.svg", sub_menu: "returns", url: "#sidebar-returns" %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::Product %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarProduct">
      <%= main_menu_tree Spree.t(:products), icon: "products.svg", sub_menu: "product", url: "#sidebar-product" %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::CreatorApplication %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarCreators">
      <%= tab :creator_applications, label: 'Creators', icon: 'users.svg', url: spree.admin_creator_applications_path, match_path: '/creator_' %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::Admin::ReportsController %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarReport">
      <%= tab *Spree::BackendConfiguration::REPORT_TABS, icon: 'report.svg' %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::Promotion %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarPromotion">
      <%= main_menu_tree Spree.t(:promotions), icon: "promotion.svg", sub_menu: "promotion", url: "#sidebar-promotions" %>
    </ul>
  <% end %>

  <% if can? :admin, MenuItem %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarMenus">
      <%= tab :menus, label: 'Menus', icon: 'menu.svg', url: spree.admin_menus_path %>
    </ul>
  <% end %>

  <% if can? :admin, LiveStream %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarLiveStream">
      <%= tab :live_streams, icon: 'live.svg', url: admin_live_stream_index_path %>
    </ul>
  <% end %>

  <% if can? :admin, ThreadTable %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarInbox">
      <%# Built by hand for the unread count, which the inbox page keeps up to date. %>
      <% unread = admin_inbox_unread_count %>
      <li class="sidebar-menu-item d-block w-100 position-relative <%= 'selected' if controller_name == 'inbox' %>">
        <%= link_to spree.admin_inbox_path, class: 'w-100 p-3 d-flex align-items-center icon-link with-tip action-chat.svg' do %>
          <%= svg_icon name: 'chat.svg', classes: 'mr-2 icon icon-chat.svg', width: 16, height: 16 %>
          <span class="text">Inbox</span>
          <span class="badge badge-pill badge-danger inbox-unread-badge <%= 'd-none' if unread.zero? %>" data-inbox-unread-badge>
            <span data-count><%= unread %></span><span class="sr-only"> unread conversations</span>
          </span>
        <% end %>
      </li>
    </ul>
  <% end %>

  <% if can? :admin, VisitorSession %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarVisitors">
      <%= tab :visitors, label: 'Visitors', icon: 'eye-open.svg', url: spree.admin_visitors_path %>
    </ul>
  <% end %>

  <% if can? :admin, HomepageSection %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarHomepage">
      <%= tab :homepage_sections, icon: 'list.svg', url: admin_homepage_sections_path %>
    </ul>
  <% end %>

  <% if can? :admin, ContentAsset %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarContentAssets">
      <%= tab :content_assets, icon: 'images.svg', url: admin_content_assets_path %>
    </ul>
  <% end %>

  <% if can? :admin, PushNotification %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarPushNotifications">
      <%= tab :push_notifications, icon: 'message.svg', url: admin_push_notifications_path %>
    </ul>
  <% end %>

  <% if can? :admin, AppSetting %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarAppSettings">
      <%= tab :app_settings, icon: 'settings.svg', url: admin_app_settings_path %>
    </ul>
  <% end %>

  <% if Spree.user_class && can?(:admin, Spree.user_class) %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarUser">
      <%= tab *Spree::BackendConfiguration::USER_TABS, url: spree.admin_users_path, icon: 'users.svg' %>
    </ul>
  <% end %>

  <% if can? :admin, Spree::ContentReport %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarContentReports">
      <%= tab :content_reports, label: 'Content reports', icon: 'report.svg', url: spree.admin_content_reports_path %>
    </ul>
  <% end %>

  <% if can? :admin, AffiliateAccount %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarAffiliates">
      <%= tab :affiliate_accounts, label: 'Affiliates', icon: 'money.svg', url: spree.admin_affiliate_accounts_path, match_path: Spree::Admin::AffiliatesTabHelper.affiliates_tab_match_path(spree.admin_path) %>
    </ul>
  <% end %>

  <% if can? :admin, AppFeedback %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarAppFeedback">
      <%= tab :app_feedbacks, label: 'Feedback', icon: 'message.svg', url: spree.admin_app_feedbacks_path %>
    </ul>
  <% end %>

  <% if can? :admin, SpreeAdminNative::Device %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarAdminNative">
      <%= tab :admin_native_devices, label: 'Mobile app', icon: 'extensions.svg', url: spree.admin_admin_native_devices_path %>
    </ul>
  <% end %>

  <% if can? :admin, current_store %>
    <ul class="nav nav-sidebar border-bottom" id="sidebarConfiguration">
      <%= main_menu_tree Spree.t(:configurations), icon: "settings.svg", sub_menu: "configuration", url: "#sidebar-configuration" %>
    </ul>
  <% end %>
</nav>
