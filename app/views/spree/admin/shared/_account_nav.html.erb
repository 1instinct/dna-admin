<% if try_spree_current_user %>
  <div class="btn-group">

    <button id="accountNav" type="button" class="btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
      <%= svg_icon name: "user.svg", width: '24', height: '24' %>
    </button>

    <%# Colours come from the admin theme (dna-modern.css), so the menu follows light and dark mode. %>
    <div class="dropdown-menu dropdown-menu-right account-nav-menu mt-2 mr-2">
      <div class="account-nav-email text-truncate"><%= try_spree_current_user.email %></div>

      <%# The storefront is a separate app (SITE_URL); this one's own root is not it. %>
      <% store_link = ENV['SITE_URL'].to_s.match?(%r{\Ahttps?://}) ? ENV['SITE_URL'] : (spree.root_path if spree.respond_to?(:root_path)) %>
      <% if store_link %>
        <%= link_to store_link, target: :_blank, rel: :noopener, class: 'dropdown-item account-nav-item' do %>
          <%= svg_icon name: "store.svg", width: '18', height: '18' %>
          <span><%= Spree.t(:back_to_store) %></span>
        <% end %>
      <% end %>

      <% if can?(:manage, try_spree_current_user) %>
        <%= link_to spree.edit_admin_user_path(try_spree_current_user), class: 'dropdown-item account-nav-item' do %>
          <%= svg_icon name: "user.svg", width: '18', height: '18' %>
          <span><%= Spree.t(:account) %></span>
        <% end %>
      <% end %>

      <% if admin_logout_link %>
        <%= link_to admin_logout_link, class: 'dropdown-item account-nav-item' do %>
          <%= svg_icon name: "exit.svg", width: '18', height: '18' %>
          <span><%= Spree.t(:logout) %></span>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
