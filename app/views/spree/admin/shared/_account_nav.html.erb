<% if try_spree_current_user %>
  <div class="btn-group">

    <button id="accountNav" type="button" class="btn" data-toggle="dropdown" aria-haspopup="true" aria-expanded="false" aria-label="Account menu">
      <%= svg_icon name: "user.svg", width: '24', height: '24' %>
    </button>

    <div class="dropdown-menu dropdown-menu-right overflow-hidden mt-2 p-0 mr-2">
      <div class="dropdown-item px-0 text-center bg-light">
        <span class="d-block text-dark py-2 px-4 text-truncate"><%= try_spree_current_user.email %></span>
      </div>
      <div class="dropdown-divider m-0"></div>

      <%# The storefront is a separate app (SITE_URL); this one's own root is not it. %>
      <% store_link = ENV['SITE_URL'].to_s.match?(%r{\Ahttps?://}) ? ENV['SITE_URL'] : (spree.root_path if spree.respond_to?(:root_path)) %>
      <% if store_link %>
        <%= link_to store_link, target: :_blank, rel: :noopener, class: 'd-block text-dark py-3 px-4 dropdown-item' do %>
          <%= svg_icon name: "store.svg", width: '18', height: '18' %>
          &nbsp;
          <%= Spree.t(:back_to_store) %>
        <% end %>
      <% end %>

      <% if can?(:manage, try_spree_current_user) %>
        <%= link_to spree.edit_admin_user_path(try_spree_current_user), class: 'd-block text-dark py-3 px-4 dropdown-item' do %>
          <%= svg_icon name: "user.svg", width: '18', height: '18' %>
          &nbsp;
          <%= Spree.t(:account) %>
        <% end %>
      <% end %>

      <% if admin_logout_link %>
        <%= link_to admin_logout_link, class: 'd-block text-dark py-3 px-4 dropdown-item' do %>
          <%= svg_icon name: "exit.svg", width: '18', height: '18' %>
          &nbsp;
          <%= Spree.t(:logout) %>
        <% end %>
      <% end %>
    </div>
  </div>
<% end %>
