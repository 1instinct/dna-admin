<style>
  .admin .container {
    max-width: 100%!important;
  }

  .conversation-list {
    max-height: calc(100vh - 200px);
    overflow-y: auto;
  }

  .conversation-item {
    padding: 15px;
    border-bottom: 1px solid var(--admin-border, #e9ecef);
    cursor: pointer;
    transition: background-color 0.2s;
  }

  .conversation-item:hover {
    background-color: var(--admin-surface-raised, #f8f9fa);
  }

  .conversation-item.active {
    background-color: rgba(0, 123, 255, 0.1);
    background-color: color-mix(in srgb, var(--admin-primary, #007bff) 14%, transparent);
  }

  .participant-info {
    display: flex;
    align-items: center;
    margin-bottom: 8px;
  }

  .initials-avatar {
    display: inline-flex;
    flex-shrink: 0;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    color: #fff;
    font-weight: 600;
    line-height: 1;
  }

  .participant-info .initials-avatar {
    margin-right: 10px;
  }

  .participant-details {
    flex-grow: 1;
  }

  .participant-name {
    font-weight: 600;
    font-size: 14px;
    margin-bottom: 2px;
  }

  .participant-role {
    font-size: 11px;
    color: #6c757d;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .participant-role.customer {
    color: #007bff;
  }

  .participant-role.support {
    color: #28a745;
  }

  .vs-separator {
    font-size: 12px;
    color: #adb5bd;
    font-weight: 500;
    margin: 5px 0;
  }

  .messages-card {
    width: 100%;
    height: 100%;
  }

  .chat-bubble {
    background-color: var(--admin-surface-raised, #f8f9fa);
    color: var(--admin-text, inherit);
    overflow-wrap: anywhere;
  }

  .chat-online {
    color: #34ce57
  }

  .chat-offline {
    color: #e4606d
  }

  .chat-messages {
    display: flex;
    flex-direction: column;
    max-height: 800px;
    overflow-y: scroll
  }

  .chat-message-left,
  .chat-message-right {
    display: flex;
    flex-shrink: 0
  }

  .chat-message-left {
    margin-right: auto
  }

  .chat-message-right {
    flex-direction: row-reverse;
    margin-left: auto
  }
  
  .search-box {
    position: sticky;
    top: 0;
    background: var(--admin-surface, #fff);
    z-index: 10;
    padding: 15px;
    border-bottom: 1px solid var(--admin-border, #dee2e6);
  }

  /* Phones show the list or the open conversation, not both stacked. */
  @media (max-width: 991.98px) {
    .conversation-list,
    .chat-messages {
      max-height: none;
    }
    .chat-messages {
      padding: 1rem !important;
    }
    /* Narrow avatar column: let "x minutes ago" wrap under the avatar
       instead of squeezing the message. */
    .chat-message-left > div:first-child,
    .chat-message-right > div:first-child {
      flex: 0 0 56px;
      text-align: center;
    }
    .chat-messages .text-nowrap {
      white-space: normal !important;
      font-size: 11px;
    }
  }
</style>

<% has_selection = params[:users].present? %>
<main class="content">
  <div class="container p-0">
    <div class="card messages-card">
      <div class="row g-0">
        <div class="col-12 col-lg-5 col-xl-4 border-right <%= 'd-none d-lg-block' if has_selection %>">
          <div class="search-box">
            <input type="text" id="conversationSearch" class="form-control" placeholder="Search conversations...">
          </div>
          
          <div class="conversation-list">
            <% @users_array.each do |user_hash| %>
              <% users = fetch_users(user_hash) %>
              <% 
                # Determine who is customer and who is support
                user_1 = users[0]
                user_2 = users[1]
                
                # Assume Contact = customer, Spree::User = support staff
                customer = user_1[:type] == 'Contact' ? user_1 : user_2
                support = user_1[:type] == 'User' ? user_1 : user_2
                
                # Determine if current conversation is active
                is_active = params[:users].present? && 
                           params[:users].any? { |u| u[:id].to_s == user_1[:id].to_s } &&
                           params[:users].any? { |u| u[:id].to_s == user_2[:id].to_s }
              %>
              
              <%= link_to spree.conversations_admin_messages_path(users: users), 
                          class: "conversation-item #{is_active ? 'active' : ''}",
                          style: "text-decoration: none; color: inherit; display: block;",
                          data: { search_text: "#{customer[:name]} #{support[:name]}" } do %>
                
                <!-- Customer Info -->
                <div class="participant-info">
                  <%= initials_avatar(customer[:name], color: '#007bff') %>
                  <div class="participant-details">
                    <div class="participant-name"><%= customer[:name] %></div>
                    <div class="participant-role customer">👤 Customer</div>
                  </div>
                </div>
                
                <div class="vs-separator text-center">↕️</div>
                
                <!-- Support Staff Info -->
                <div class="participant-info">
                  <%= initials_avatar(support[:name], color: '#28a745') %>
                  <div class="participant-details">
                    <div class="participant-name"><%= support[:name] %></div>
                    <div class="participant-role support">🎧 Support Staff</div>
                  </div>
                </div>
              <% end %>
            <% end %>
          </div>
          
          <script>
            // Search functionality
            document.getElementById('conversationSearch').addEventListener('input', function(e) {
              const searchTerm = e.target.value.toLowerCase();
              const conversations = document.querySelectorAll('.conversation-item');
              
              conversations.forEach(function(conversation) {
                const searchText = conversation.getAttribute('data-search_text').toLowerCase();
                if (searchText.includes(searchTerm)) {
                  conversation.style.display = 'block';
                } else {
                  conversation.style.display = 'none';
                }
              });
            });
          </script>
          
          <hr class="d-block d-lg-none mt-1 mb-0">
        </div>
        <div class="col-12 col-lg-7 col-xl-8 <%= 'd-none d-lg-block' unless has_selection %>">
          <div class="d-lg-none py-2 px-3 border-bottom">
            <%= link_to '← All conversations', spree.conversations_admin_messages_path, class: 'd-inline-flex align-items-center', style: 'min-height: 44px;' %>
          </div>
          <div class="py-2 px-4 border-bottom d-none d-lg-block">
            <div class="d-flex align-items-center py-1">
              <div class="position-relative">
                <h4>Conversation</h4>
              </div>
            </div>
          </div>
          <div class="position-relative">
            <div class="chat-messages p-4">
              <% if @threads.present? %>
                <% @threads.each do |thread| %>
                  <% thread.each do |message| %>
                    <% 
                      sender_name = message.sender_type == "Spree::User" ? message.sender.email : message.sender.full_name
                      is_support = message.sender_type == "Spree::User"
                      avatar_bg = is_support ? "28a745" : "007bff"
                      role_label = is_support ? "🎧 Support" : "👤 Customer"
                    %>
                    
                    <% if message.sender == @user_1 %>
                      <div class="chat-message-right pb-4">
                        <div>
                          <%= initials_avatar(sender_name, color: "##{avatar_bg}") %>
                          <div class="text-muted small text-nowrap mt-2"><%= distance_of_time_in_words(message.created_at, Time.now) %> ago</div>
                        </div>
                        <div class="flex-shrink-1 chat-bubble rounded py-2 px-3 mr-3">
                          <div class="font-weight-bold mb-1">
                            <%= sender_name %>
                            <span class="badge badge-<%= is_support ? 'success' : 'primary' %> ml-2" style="font-size: 10px;"><%= role_label %></span>
                          </div>
                          <%= message.message %>
                        </div>
                      </div>
                    <% elsif message.sender == @user_2  %>
                      <div class="chat-message-left pb-4">
                        <div>
                          <%= initials_avatar(sender_name, color: "##{avatar_bg}") %>
                          <div class="text-muted small text-nowrap mt-2"><%= distance_of_time_in_words(message.created_at, Time.now) %> ago</div>
                        </div>
                        <div class="flex-shrink-1 chat-bubble rounded py-2 px-3 ml-3">
                          <div class="font-weight-bold mb-1">
                            <%= sender_name %>
                            <span class="badge badge-<%= is_support ? 'success' : 'primary' %> ml-2" style="font-size: 10px;"><%= role_label %></span>
                          </div>
                          <%= message.message %>
                        </div>
                      </div>
                    <% end %>
                  <% end %>
                  <hr width="100%">
                <% end %>
              <% end %>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</main>
