<div class="row">
  <div class="col-12 col-md-6">
    <%= f.field_container :platform, class: ['form-group'] do %>
      <%= f.label :platform %>
      <%= f.select :platform, Spree::IapProduct::PLATFORMS, {}, class: 'form-control' %>
    <% end %>
    <%= f.field_container :product_id, class: ['form-group'] do %>
      <%= f.label :product_id, 'Store product id' %>
      <%= f.text_field :product_id, class: 'form-control' %>
      <%= f.error_message_on :product_id %>
    <% end %>
    <%= f.field_container :name, class: ['form-group'] do %>
      <%= f.label :name %>
      <%= f.text_field :name, class: 'form-control' %>
    <% end %>
  </div>
  <div class="col-12 col-md-6">
    <%= f.field_container :kind, class: ['form-group'] do %>
      <%= f.label :kind %>
      <%= f.select :kind, Spree::IapProduct::KINDS, {}, class: 'form-control' %>
    <% end %>
    <%= f.field_container :entitlement, class: ['form-group'] do %>
      <%= f.label :entitlement, 'Entitlement key (e.g. pro)' %>
      <%= f.text_field :entitlement, class: 'form-control' %>
    <% end %>
    <%= f.field_container :store_id, class: ['form-group'] do %>
      <%= f.label :store_id, 'Store' %>
      <%= f.collection_select :store_id, Spree::Store.order(:name), :id, :name, { include_blank: 'All stores' }, class: 'form-control' %>
    <% end %>
    <div class="form-group">
      <%= f.check_box :active %> <%= f.label :active %>
    </div>
  </div>
</div>
