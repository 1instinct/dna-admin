<div class="modal fade" id="<%= id %>" tabindex="-1" role="dialog" aria-labelledby="<%= id %>-title" aria-hidden="true">
  <div class="modal-dialog" role="document">
    <%= form_with model: location, scope: :menu_location, url: url, method: method, local: true, class: 'modal-content' do |f| %>
      <div class="modal-header">
        <h2 class="modal-title h5" id="<%= id %>-title"><%= title %></h2>
        <button type="button" class="close" data-dismiss="modal" aria-label="Close"><span aria-hidden="true">&times;</span></button>
      </div>
      <div class="modal-body">
        <div class="form-group">
          <%= f.label :title, 'Name', for: "#{id}-name" %>
          <%= f.text_field :title, id: "#{id}-name", class: 'form-control', required: true, maxlength: 255,
                                   placeholder: 'Main menu', autocomplete: 'off' %>
        </div>
        <div class="form-group">
          <%= f.label :location, 'Location key', for: "#{id}-key" %>
          <%= f.text_field :location, id: "#{id}-key", class: 'form-control', maxlength: 255, placeholder: 'header',
                                      'aria-describedby': "#{id}-key-hint", autocomplete: 'off' %>
          <small class="form-text text-muted" id="<%= id %>-key-hint">The name the storefront asks for, such as header or footer.</small>
        </div>
        <div class="form-check">
          <%= f.hidden_field :is_visible, value: '0', id: nil %>
          <%= f.check_box :is_visible, { id: "#{id}-visible", class: 'form-check-input' }, '1', nil %>
          <%= f.label :is_visible, 'Visible on the storefront', for: "#{id}-visible", class: 'form-check-label' %>
        </div>
      </div>
      <div class="modal-footer">
        <button type="button" class="btn btn-outline-secondary" data-dismiss="modal">Cancel</button>
        <%= f.submit submit, class: 'btn btn-primary' %>
      </div>
    <% end %>
  </div>
</div>
