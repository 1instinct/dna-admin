<%= render partial: 'spree/admin/shared/product_tabs', locals: { current: :videos } %>

<% content_for :page_actions do %>
  <%= yield :page_actions %>
  <%= product_preview_link(@product) %>
  <%= button_link_to(Spree.t(:new_product_video, default: 'New Video'), spree.new_admin_product_product_video_url(@product), { class: "btn-success", icon: 'add.svg', id: 'new_product_video_link' }) if can? :create, Spree::ProductVideo %>
<% end %>

<% if @product_videos.empty? %>
  <div class="alert alert-warning">
    <%= Spree.t(:no_resource_found, resource: plural_resource_name(Spree::ProductVideo)) %>.
  </div>
<% else %>
  <div class="table-responsive">
    <table class="table sortable" data-hook="product_videos_table" data-sortable-link="<%= spree.update_positions_admin_product_product_videos_url(@product) %>">
      <thead>
        <tr data-hook="product_videos_header">
          <th colspan="2">
            <%= Spree.t(:poster, default: 'Poster') %>
          </th>
          <th>
            <%= Spree.t(:file, default: 'File') %>
          </th>
          <th>
            <%= Spree.t(:alt_text) %>
          </th>
          <th class="actions"></th>
        </tr>
      </thead>
      <tbody id="sortVert">
        <% @product_videos.each do |product_video| %>
          <tr id="<%= spree_dom_id product_video %>" data-hook="product_videos_row">
            <td class="move-handle text-center">
              <% if can? :edit, product_video %>
                <%= svg_icon name: "sort.svg", width: '18', height: '18' %>
              <% end %>
            </td>
            <td class="image">
              <% if product_video.poster_thumb_url %>
                <%= image_tag(main_app.url_for(product_video.poster.variant(resize: '48x48>'))) %>
              <% end %>
            </td>
            <td>
              <% if product_video.video.attached? %>
                <%= link_to product_video.video.filename.to_s, main_app.rails_blob_url(product_video.video) %>
                <small class="text-muted d-block">
                  <%= product_video.video.content_type %>, <%= number_to_human_size(product_video.video.byte_size) %>
                </small>
              <% end %>
            </td>
            <td><%= product_video.alt %></td>
            <td class="actions actions-2 text-right">
              <%= link_to_with_icon('edit.svg', Spree.t(:edit), spree.edit_admin_product_product_video_url(@product, product_video), class: 'btn btn-primary btn-sm', no_text: true, data: { action: 'edit' }) if can? :edit, product_video %>
              <%= link_to_delete(product_video, { url: spree.admin_product_product_video_url(@product, product_video), no_text: true }) if can? :destroy, product_video %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
<% end %>
