<% content_for :page_title do %>
  Creator earnings
<% end %>

<%= render 'spree/admin/creator_applications/tabs', current: :earnings %>

<% content_for :table_filter do %>
  <div data-hook="admin_creator_earnings_filter">
    <%= form_tag spree.admin_creator_earnings_path, method: :get do %>
      <div class="row">
        <div class="col-12 col-lg-4">
          <div class="form-group">
            <%= label_tag :state, 'State' %>
            <%= select_tag :state, options_for_select(Spree::CreatorEarning::STATES.map { |s| [s.capitalize, s] }, @state),
                           include_blank: 'All', class: 'form-control' %>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="form-group">
            <%= label_tag :creator_account_id, 'Creator' %>
            <%= select_tag :creator_account_id, options_for_select(@accounts.map { |a| [a.user&.email || "Account #{a.id}", a.id] }, @account_id),
                           include_blank: 'All', class: 'form-control' %>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <%= button Spree.t(:filter_results), 'search.svg' %>
      </div>
    <% end %>
  </div>
<% end %>

<% if @earnings.any? %>
  <div class="table-responsive">
    <table class="table table-sm" id="listing_creator_earnings">
      <thead>
        <tr>
          <th>Creator</th>
          <th>Order</th>
          <th>Item</th>
          <th class="text-right">Gross</th>
          <th class="text-right">Share</th>
          <th class="text-right">Earned</th>
          <th>State</th>
          <th>Payable from</th>
          <th>Created</th>
        </tr>
      </thead>
      <tbody>
        <% @earnings.each do |earning| %>
          <tr id="creator_earning_<%= earning.id %>">
            <td><%= earning.creator_account&.user&.email || "Account #{earning.creator_account_id}" %></td>
            <td><%= earning.order ? link_to(earning.order.number, spree.edit_admin_order_path(earning.order)) : earning.order_id %></td>
            <td><%= earning.line_item ? "#{earning.line_item.quantity} × #{earning.line_item.name}" : earning.line_item_id %></td>
            <td class="text-right"><%= number_with_precision(earning.gross, precision: 2) %> <%= earning.currency %></td>
            <td class="text-right"><%= number_to_percentage(earning.share_bps / 100.0, precision: 2, strip_insignificant_zeros: true) %></td>
            <td class="text-right"><%= number_with_precision(earning.amount, precision: 2) %> <%= earning.currency %></td>
            <td><%= render 'spree/admin/creator_applications/status_badge', status: earning.state %></td>
            <td class="text-nowrap"><%= l(earning.payable_at, format: :short) %></td>
            <td class="text-nowrap"><%= l(earning.created_at, format: :short) %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= paginate @earnings %>
<% else %>
  <div class="alert alert-info no-objects-found">No earnings match these filters.</div>
<% end %>
