<% content_for :page_title do %>
  Questions
<% end %>

<% content_for :page_actions do %>
  <span class="text-muted small">
    <%= @counts.fetch('pending', 0) %> waiting · <%= @counts.fetch('published', 0) %> answered
  </span>
<% end %>

<% content_for :table_filter do %>
  <div data-hook="admin_product_questions_filter">
    <%= form_tag spree.admin_product_questions_path, method: :get do %>
      <div class="row">
        <div class="col-6 col-lg-2">
          <div class="form-group">
            <%= label_tag :status, 'Status' %>
            <%= select_tag :status, options_for_select([['All', 'all']] + Spree::ProductQuestion::STATUSES.map { |s| [Spree::Admin::ProductQuestionsHelper::QUESTION_STATUS_LABELS[s], s] }, @filters[:status]), class: 'form-control' %>
          </div>
        </div>
        <div class="col-12 col-lg-4">
          <div class="form-group">
            <%= label_tag :q, 'Search' %>
            <%= search_field_tag :q, @filters[:q], placeholder: 'Product, question or name', class: 'form-control' %>
          </div>
        </div>
      </div>
      <div class="form-actions">
        <%= button Spree.t(:filter_results), 'search.svg' %>
      </div>
    <% end %>
  </div>
<% end %>

<div class="alert alert-light border small" role="note">
  Only answered questions show on the product page. Answering publishes the question and emails the customer who asked.
</div>

<% if @questions.any? %>
  <div class="table-responsive">
    <table class="table table-sm" id="listing_product_questions">
      <thead>
        <tr>
          <th>Date</th>
          <th>Product</th>
          <th>Question</th>
          <th>By</th>
          <th>Answers</th>
          <th>Status</th>
          <th class="actions"></th>
        </tr>
      </thead>
      <tbody>
        <% @questions.each do |question| %>
          <tr id="question_<%= question.id %>">
            <td class="text-nowrap"><%= l(question.created_at, format: :short) %></td>
            <td><%= question_product_link(question) %></td>
            <td><%= truncate(question.body, length: 140) %></td>
            <td><%= question.display_name %></td>
            <td><%= question.answers_count %></td>
            <td><%= question_status_badge(question) %></td>
            <td class="actions text-right"><%= link_to question.status == 'pending' ? 'Answer' : 'Open', spree.admin_product_question_path(question), class: 'btn btn-sm btn-light' %></td>
          </tr>
        <% end %>
      </tbody>
    </table>
  </div>
  <%= paginate @questions, theme: 'twitter-bootstrap-4' %>
<% else %>
  <div class="alert alert-info no-objects-found">No questions match these filters.</div>
<% end %>
