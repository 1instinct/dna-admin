<div class="divclass">
  <div class="col-lg-11 mx-auto wrapper">
    <div class="forbidden-container">
      <%= image_tag 'instinct_logo.png', style: "height: 100px; margin-bottom: 30px;" %>
      
      <h1 class="forbidden-title">Access Denied</h1>
      
      <p class="forbidden-message">
        You don't have permission to access this area.
      </p>
      
      <p class="forbidden-info">
        This section is restricted to administrators only. 
        If you believe you should have access, please contact your system administrator.
      </p>
      
      <div class="forbidden-actions">
        <% if spree_current_user %>
          <%= link_to "Return to Home", root_path, class: 'btn btn-primary' %>
          <%= link_to "Sign Out", spree.logout_path, class: 'btn btn-secondary' %>
        <% else %>
          <%= link_to "Sign In", spree_login_path, class: 'btn btn-primary' %>
        <% end %>
      </div>
    </div>
  </div>
</div>

<style type="text/css">
  .divclass {
    font-family: "Open Sans", sans-serif;
    height: 100vh;
    background-size: cover;
  }

  .wrapper {
    display: flex;
    align-items: center;
    flex-direction: column;
    justify-content: center;
    width: 100%;
    min-height: 100%;
    padding: 20px;
    background: rgba(33, 150, 243, 0.85);
    font-family: "Open Sans", sans-serif;
    height: 100vh;
    background-image: url("https://i.imgur.com/yzS1Nse.jpeg");
    background-size: cover;
  }

  .forbidden-container {
    border-radius: 5px;
    padding: 40px 30px;
    width: 90%;
    max-width: 500px;
    background: #ffffff;
    text-align: center;
    box-shadow: 0px 2px 10px rgba(0,0,0,0.3);
  }

  .forbidden-title {
    color: #d32f2f;
    font-size: 32px;
    font-weight: 600;
    margin-bottom: 20px;
  }

  .forbidden-message {
    color: #333;
    font-size: 18px;
    margin-bottom: 15px;
    font-weight: 500;
  }

  .forbidden-info {
    color: #666;
    font-size: 14px;
    margin-bottom: 30px;
    line-height: 1.6;
  }

  .forbidden-actions {
    display: flex;
    gap: 15px;
    justify-content: center;
    flex-wrap: wrap;
  }

  .forbidden-actions .btn {
    padding: 12px 30px;
    font-size: 16px;
    border-radius: 4px;
    text-decoration: none;
    border: none;
    cursor: pointer;
    transition: all 0.3s ease;
  }

  .forbidden-actions .btn-primary {
    background: #2196F3;
    color: white;
  }

  .forbidden-actions .btn-primary:hover {
    background: #1976D2;
  }

  .forbidden-actions .btn-secondary {
    background: #757575;
    color: white;
  }

  .forbidden-actions .btn-secondary:hover {
    background: #616161;
  }
</style>
