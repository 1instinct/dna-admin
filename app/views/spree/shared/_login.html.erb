<%#
  The sign-in form. Rendered inside spree/layouts/sign_in by
  ApplicationController#require_login (template spree/shared/sign_in).
%>
<h1 class="si-title">Sign in</h1>
<p class="si-subtitle">Use your admin account to continue.</p>

<%= render partial: 'spree/shared/sign_in_flash' %>

<%= form_for Spree.user_class.new, as: :spree_user, url: spree_login_path, html: { data: { sign_in_form: true } } do |f| %>
  <div class="si-field">
    <%= f.label :email, Spree.t(:email), class: 'si-label' %>
    <%= f.email_field :email,
          class: 'si-input',
          value: params.dig(:spree_user, :email),
          required: true,
          autocomplete: 'username',
          autocapitalize: 'none',
          autocorrect: 'off',
          spellcheck: false,
          inputmode: 'email',
          enterkeyhint: 'next',
          placeholder: 'you@example.com' %>
  </div>

  <div class="si-field">
    <%= f.label :password, Spree.t(:password), class: 'si-label' %>
    <div class="si-input-wrap">
      <%= f.password_field :password,
            class: 'si-input si-input--with-toggle',
            required: true,
            autocomplete: 'current-password',
            autocapitalize: 'none',
            autocorrect: 'off',
            spellcheck: false,
            enterkeyhint: 'go' %>
      <button type="button" class="si-toggle" data-password-toggle aria-controls="spree_user_password" aria-pressed="false" hidden>Show</button>
    </div>
  </div>

  <div class="si-row">
    <% if Spree::Frontend::Config[:remember_me_enabled] %>
      <label class="si-check" for="spree_user_remember_me">
        <%= f.check_box :remember_me %>
        <span><%= Spree.t(:remember_me) %></span>
      </label>
    <% else %>
      <span></span>
    <% end %>

    <% if spree.respond_to?(:recover_password_path) %>
      <%= link_to Spree.t(:forgot_password), spree.recover_password_path, class: 'si-link' %>
    <% end %>
  </div>

  <%= button_tag type: 'submit', class: 'si-button' do %>
    <span class="si-spinner" aria-hidden="true"></span>
    <span data-busy-label="Signing in…"><%= Spree.t(:log_in) %></span>
  <% end %>
<% end %>
