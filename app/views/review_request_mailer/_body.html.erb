<%# Shared by request_review and reminder. Inline styles only: email clients drop <style> blocks. %>
<table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="background:#ffffff;">
  <tr>
    <td align="center" style="padding:24px 16px;">
      <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;font-family:Helvetica,Arial,sans-serif;color:#1a1a1a;">
        <tr>
          <td style="padding:0 0 8px 0;font-family:'IBM Plex Mono',Menlo,Consolas,monospace;font-size:20px;letter-spacing:2px;text-transform:uppercase;">
            <%= @subject %>
          </td>
        </tr>
        <tr>
          <td style="padding:0 0 20px 0;font-size:15px;line-height:22px;">
            <% if @reminder %>
              You can still rate the pieces from order <%= @order.number %>.
            <% else %>
              Your order <%= @order.number %> shipped a little while ago. We'd like to know what you think.
            <% end %>
            Tap a star to rate each piece. You can add a few words or photos on the next page, or leave it at the stars.
          </td>
        </tr>
        <% @items.each do |item| %>
          <tr>
            <td style="padding:16px 0;border-top:1px solid #E6CDC0;" id="item-<%= item[:line_item_id] %>">
              <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
                <tr>
                  <% if item[:image_url] %>
                    <td width="96" valign="top" style="padding:0 16px 0 0;">
                      <img src="<%= item[:image_url] %>" width="96" height="96" alt="<%= item[:name] %>" style="display:block;border:0;width:96px;height:96px;object-fit:cover;">
                    </td>
                  <% end %>
                  <td valign="top">
                    <div style="font-size:16px;line-height:22px;font-weight:bold;"><%= item[:name] %></div>
                    <% if item[:variant_label].present? %>
                      <div style="font-size:13px;line-height:20px;color:#666666;"><%= item[:variant_label] %></div>
                    <% end %>
                    <div style="padding-top:8px;white-space:nowrap;">
                      <% item[:stars].each do |star| %><a href="<%= star[:url] %>" aria-label="<%= star[:label] %>" title="<%= star[:label] %>" style="display:inline-block;padding:4px 6px 4px 0;font-size:32px;line-height:36px;color:#EB8B8B;text-decoration:none;">&#9734;</a><% end %>
                    </div>
                  </td>
                </tr>
              </table>
            </td>
          </tr>
        <% end %>
        <tr>
          <td style="padding:16px 0 0 0;border-top:1px solid #E6CDC0;font-size:14px;line-height:21px;">
            <a href="<%= @review_url %>" style="color:#1a1a1a;">Open your review page</a>
          </td>
        </tr>
        <% if @points %>
          <tr>
            <td style="padding:12px 0 0 0;font-size:14px;line-height:21px;color:#444444;">
              Members earn <%= @points %> points for every review<% if @photo_bonus %>, plus <%= @photo_bonus %> with a photo<% end %>, whatever the rating.
            </td>
          </tr>
        <% end %>
        <tr>
          <td style="padding:24px 0 0 0;font-size:12px;line-height:18px;color:#888888;">
            This link is just for you<% if @expires_on %> and works until <%= l(@expires_on, format: :long) %><% end %>.
            Don't want these emails? <a href="<%= @opt_out_url %>" style="color:#888888;">Stop review emails</a>.
          </td>
        </tr>
      </table>
    </td>
  </tr>
</table>
